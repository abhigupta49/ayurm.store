# ===== AYURM configuration =====
# Copy this file to .env.local and fill in your real values.

# Public site URL (used for SEO, canonical, sitemap, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL="https://ayurm.in"

# WhatsApp number in international format WITHOUT + or spaces, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER="8479053871"

# Business contact email shown on the site
NEXT_PUBLIC_CONTACT_EMAIL="ayrum.store@gmail.com"

# Social links (optional)
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/ayurm.store"
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""

# Analytics (optional — leave blank to disable)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Admin password for /admin/orders (CHANGE THIS before launch)
ADMIN_PASSWORD="admin@2312"
